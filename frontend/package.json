{
  "name": "psy-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo": "NEXT_PUBLIC_DEMO=1 next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && node scripts/check-migrations.mjs",
    "ship": "node scripts/ship.mjs",
    "deploy:demo": "node scripts/deploy-demo.mjs",
    "deploy:status": "node scripts/deploy-demo.mjs --status",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "bot": "bun run scripts/bot.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.1.0",
    "@tanstack/react-query": "^5.62.0",
    "@telegram-apps/sdk": "^3.0.0",
    "grammy": "^1.30.0",
    "jose": "^5.9.0",
    "motion": "^11.15.0",
    "next": "^15.5.21",
    "nodemailer": "^9.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.1.0",
    "puppeteer-core": "^25.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
