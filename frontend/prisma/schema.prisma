generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователь платформы. В МВП вход через Telegram → это психолог.
model User {
  id         Int       @id @default(autoincrement())
  telegramId BigInt    @unique
  username   String?
  firstName  String?
  role       String    @default("client") // psychologist | client
  /// Администратор платформы. Ставится вручную в базе: через интерфейс выдать
  /// нельзя, иначе первый же баг в правах раздаёт админку.
  isAdmin    Boolean   @default(false)
  /// Блокировка нарушителя: вход остаётся, но доступ к API закрыт.
  blockedAt  DateTime?
  createdAt  DateTime  @default(now())

  // Почта привязывается внутри мини-приложения и служит входом в веб-версию.
  email             String?   @unique
  emailVerifiedAt   DateTime?
  /// Дополнительное напоминание клиенту за 2 часа. За 24 часа обязательно.
  sessionReminder2h Boolean   @default(false)

  // Мягкое удаление: по требованию об удалении ПД гасим доступ сразу,
  // физическая очистка идёт отдельным заданием с записью в аудит.
  deletedAt DateTime?

  clients            Client[]
  appointments       Appointment[]
  subscription       Subscription?
  sessions           Session[]
  consents           Consent[]
  auditEntries       AuditLog[]
  workHours          WorkHours?
  slotOverrides      SlotOverride[]
  psyProfile         PsyProfile?
  /// Карточки, в которых этот пользователь — клиент (обратная сторона Client.user).
  clientCards        Client[]           @relation("ClientUser")
  notifications      Notification[]
  telegramDeliveries TelegramDelivery[]
  supportRequests    SupportRequest[]
  payments           Payment[]
  psyDocuments       PsyDocument[]
}

/// Диплом или сертификат психолога. Отдельной таблицей, а не полем в
/// PsyProfile.data: из Json их больно выковыривать при требовании об удалении
/// ПД, а список анкет в админке не должен тащить мегабайты вложений.
/// Сам файл лежит на диске сервера зашифрованным (см. lib/server/files.ts);
/// в базе — только метаданные и имя файла в хранилище.
model PsyDocument {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// diploma — основной документ об образовании, certificate — всё остальное.
  kind      String   @default("diploma")
  name      String
  mime      String
  size      Int
  /// Имя файла в UPLOAD_DIR. Случайное: по нему нельзя угадать чужой документ.
  storageKey String  @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Шаблон рабочих часов: по одной записи на психолога.
/// hours — { "0": [{ t: "10:00", d: 50, fmt: "online" }], … }, ключ = день недели
/// с понедельника. Держим JSON, а не таблицей окон: это настройка, её читают
/// и пишут целиком, а запросов «найди все окна в 10:00 по всем психологам» нет.
model WorkHours {
  userId         Int      @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hours          Json     @default("{}")
  sessionMinutes Int      @default(50)
  updatedAt      DateTime @updatedAt
}

/// Правка одного окна на конкретную дату поверх шаблона: снято или сменён
/// формат. Отдельная таблица, потому что записей мало и они точечные.
model SlotOverride {
  id       String   @id @default(uuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  startsAt DateTime
  removed  Boolean  @default(false)
  fmt      String? // online | offline; null — как в шаблоне

  @@unique([userId, startsAt])
  @@index([userId])
}

/// Живая сессия устройства. Храним только хэш refresh-токена: утечка базы
/// не даёт войти. familyId связывает цепочку ротаций — если старый токен
/// предъявили повторно, гасим всю цепочку (признак кражи).
model Session {
  id           String    @id @default(uuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  familyId     String
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?

  @@index([userId, revokedAt])
  @@index([familyId])
}

/// Одноразовый код для входа в веб-версию. Тоже только хэш.
model EmailOtp {
  id        String    @id @default(uuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([email, expiresAt])
}

/// Согласия по 152-ФЗ. Отдельная запись на каждый вид и версию документа —
/// без этого нельзя доказать, на что именно человек соглашался.
model Consent {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  kind          String // pd | health | offer | marketing
  policyVersion String
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  ip            String?
  userAgent     String?

  @@index([userId, kind])
}

/// Журнал действий с персональными данными: кто, что, когда.
model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    Int?
  action    String // login | logout | export | delete | consent.grant | payment …
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// Карточка клиента, которую ведёт психолог. Не обязательно юзер платформы.
model Client {
  id             Int      @id @default(autoincrement())
  psychologist   User     @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  psychologistId Int
  name           String
  contact        String? // телефон / телеграм / email
  note           String   @default("") @db.Text // заметки психолога — шифруются
  status         String   @default("new") // new | therapy | paused
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Карточку ведёт психолог; если клиент подключил свой профиль — здесь его
  /// аккаунт. Отсюда же берётся, чьи это настроение и задания.
  user                    User?     @relation("ClientUser", fields: [userId], references: [id], onDelete: SetNull)
  userId                  Int?
  link                    String    @default("none") // none | invited | joined
  invitedAt               DateTime?
  /// Модуль заметок: клиент может вести лично или делиться со специалистом.
  notesModuleEnabled      Boolean   @default(false)
  notesModuleShared       Boolean   @default(true)
  notesModulePsychologist Boolean   @default(false)

  appointments Appointment[]
  homework     Homework[]
  moods        Mood[]
  goodNotes    GoodNote[]
  therapy      TherapyProfile?
  reflections  SessionReflection[]

  @@index([psychologistId])
  @@index([userId])
}

/// Публичная анкета психолога — то, что видно в каталоге.
/// Основная масса полей (методы, темы, фото, ссылки, адрес) лежит в JSON:
/// это карточка, её читают и пишут целиком. Отдельными колонками вынесено
/// только то, по чему каталог фильтрует и сортирует.
model PsyProfile {
  userId          Int      @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  primaryMethod   String   @default("")
  experienceYears Int      @default(0)
  sessionPrice    Int      @default(0)
  sessionMinutes  Int      @default(50)
  format          String   @default("online") // online | offline | both
  city            String   @default("")
  /// draft — анкета заполняется, review — на модерации, approved — опубликована
  /// в каталоге, rejected — отказ с причиной в rejectReason.
  status          String   @default("draft")
  /// Почему отказали. Без причины человек не понимает, что переснять, и уходит.
  rejectReason    String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  data            Json     @default("{}")
  updatedAt       DateTime @updatedAt

  @@index([status, sessionPrice])
}

/// Уведомление в колокольчике. Пишется по факту события, читается владельцем.
model Notification {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  kind      String // system | booking | cancel | reschedule | homework
  text      String    @db.Text
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
}

/// Обращение в поддержку. Храним у себя, а не только шлём в чат: иначе
/// потерянное сообщение никак не найти, а человек ждёт ответа.
model SupportRequest {
  id        Int       @id @default(autoincrement())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    Int?
  topic     String    @default("other")
  text      String    @db.Text
  contact   String?
  createdAt DateTime  @default(now())
  handledAt DateTime?

  @@index([createdAt])
}

/// Домашнее задание от психолога клиенту.
model Homework {
  id       Int      @id @default(autoincrement())
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId Int
  text     String   @db.Text // шифруется
  status   String   @default("assigned") // assigned | doing | done
  sentAt   DateTime @default(now())

  @@index([clientId, sentAt])
}

/// Отметка настроения за день. Одна на день — повторная правит существующую.
model Mood {
  id       Int      @id @default(autoincrement())
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId Int
  day      DateTime @db.Date
  mood     Int
  emotions Json     @default("[]")

  @@unique([clientId, day])
  @@index([clientId, day])
}

/// «Что хорошего принёс день» — короткая запись клиента. Тоже одна на день.
model GoodNote {
  id       Int      @id @default(autoincrement())
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId Int
  day      DateTime @db.Date
  text     String   @db.Text // шифруется

  @@unique([clientId, day])
}

/// Состояние терапии клиента: доска для терапевта и колесо баланса.
model TherapyProfile {
  clientId     Int      @id
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  board        String   @default("") @db.Text // шифруется
  wheel        Json? // { answers: {ключ: number[]}, completedAt }
  tutorialSeen Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

// Запись на приём.
model Appointment {
  id                 Int                @id @default(autoincrement())
  psychologist       User               @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  psychologistId     Int
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId           Int
  startsAt           DateTime
  durationMin        Int                @default(60)
  format             String             @default("online") // online | offline
  status             String             @default("scheduled") // scheduled | done | cancelled
  note               String             @default("") @db.Text
  reminderSent       Boolean            @default(false)
  createdAt          DateTime           @default(now())
  telegramDeliveries TelegramDelivery[]
  reflection         SessionReflection?

  @@index([psychologistId, startsAt])
  @@index([clientId])
}

/// Короткая подготовка и итог клиента, привязанные к конкретной встрече.
/// Тексты шифруются тем же ключом, что и остальные данные терапии.
model SessionReflection {
  id            Int         @id @default(autoincrement())
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId Int         @unique
  preparation   String      @default("") @db.Text
  takeaway      String      @default("") @db.Text
  feeling       Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([clientId, updatedAt])
}

/// Очередь сообщений Telegram. Одна встреча может породить несколько
/// независимых доставок: событие расписания и напоминания за 24/2 часа.
model TelegramDelivery {
  id            Int         @id @default(autoincrement())
  recipient     User        @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId   Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId Int
  audience      String // psychologist | client
  kind          String // booking | reschedule | cancel | reminder_24h | reminder_2h
  payload       Json        @default("{}")
  scheduledFor  DateTime
  sentAt        DateTime?
  cancelledAt   DateTime?
  attempts      Int         @default(0)
  lastError     String?
  createdAt     DateTime    @default(now())

  @@index([scheduledFor, sentAt, cancelledAt])
  @@index([appointmentId, kind])
  @@index([recipientId, createdAt])
}

// Подписка психолога (оплата через ЮKassa).
model Subscription {
  id                Int       @id @default(autoincrement())
  psychologist      User      @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  psychologistId    Int       @unique
  plan              String    @default("free") // free | pro
  status            String    @default("inactive") // inactive | pending | active
  yookassaPaymentId String?
  paymentMethodId   String? // сохранённый способ оплаты для рекуррента
  currentPeriodEnd  DateTime?
  /// Кто выдал доступ вручную из админки. Заполнено — значит денег не было,
  /// и в отчётах такую подписку нельзя считать выручкой.
  grantedBy         Int?
  grantedNote       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// История платежей. Subscription хранит только текущее состояние: каждая
/// новая оплата затирала предыдущую, и ответить «сколько денег пришло за
/// месяц» было нечем. Здесь строка на платёж, и она больше не меняется.
model Payment {
  id             Int    @id @default(autoincrement())
  psychologist   User   @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  psychologistId Int
  /// Идентификатор платежа в ЮKassa. Уникален: вебхук и автопродление могут
  /// провести один и тот же платёж наперегонки — второй записи не появится.
  yookassaPaymentId String   @unique
  /// Копейки. В рублях с дробной частью суммы разъезжаются на сложении.
  amount            Int
  currency          String   @default("RUB")
  kind              String   @default("initial") // initial | renewal
  paidAt            DateTime @default(now())

  @@index([paidAt])
  @@index([psychologistId, paidAt])
}
