generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Пользователь платформы. В МВП вход через Telegram → это психолог.
model User {
  id         Int      @id @default(autoincrement())
  telegramId BigInt   @unique
  username   String?
  firstName  String?
  role       String   @default("psychologist") // psychologist | client
  createdAt  DateTime @default(now())

  // Почта привязывается внутри мини-приложения и служит входом в веб-версию.
  email           String?   @unique
  emailVerifiedAt DateTime?

  // Мягкое удаление: по требованию об удалении ПД гасим доступ сразу,
  // физическая очистка идёт отдельным заданием с записью в аудит.
  deletedAt DateTime?

  clients      Client[]
  appointments Appointment[]
  subscription Subscription?
  sessions     Session[]
  consents     Consent[]
  auditEntries AuditLog[]
  workHours    WorkHours?
  slotOverrides SlotOverride[]
  psyProfile   PsyProfile?
  /// Карточки, в которых этот пользователь — клиент (обратная сторона Client.user).
  clientCards  Client[]       @relation("ClientUser")
}

/// Шаблон рабочих часов: по одной записи на психолога.
/// hours — { "0": [{ t: "10:00", d: 50, fmt: "online" }], … }, ключ = день недели
/// с понедельника. Держим JSON, а не таблицей окон: это настройка, её читают
/// и пишут целиком, а запросов «найди все окна в 10:00 по всем психологам» нет.
model WorkHours {
  userId         Int      @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hours          Json     @default("{}")
  sessionMinutes Int      @default(50)
  updatedAt      DateTime @updatedAt
}

/// Правка одного окна на конкретную дату поверх шаблона: снято или сменён
/// формат. Отдельная таблица, потому что записей мало и они точечные.
model SlotOverride {
  id       String   @id @default(uuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  startsAt DateTime
  removed  Boolean  @default(false)
  fmt      String? // online | offline; null — как в шаблоне

  @@unique([userId, startsAt])
  @@index([userId])
}

/// Живая сессия устройства. Храним только хэш refresh-токена: утечка базы
/// не даёт войти. familyId связывает цепочку ротаций — если старый токен
/// предъявили повторно, гасим всю цепочку (признак кражи).
model Session {
  id           String    @id @default(uuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  familyId     String
  tokenHash    String    @unique
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?

  @@index([userId, revokedAt])
  @@index([familyId])
}

/// Одноразовый код для входа в веб-версию. Тоже только хэш.
model EmailOtp {
  id        String    @id @default(uuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([email, expiresAt])
}

/// Согласия по 152-ФЗ. Отдельная запись на каждый вид и версию документа —
/// без этого нельзя доказать, на что именно человек соглашался.
model Consent {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  kind          String // pd | health | offer | marketing
  policyVersion String
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?
  ip            String?
  userAgent     String?

  @@index([userId, kind])
}

/// Журнал действий с персональными данными: кто, что, когда.
model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    Int?
  action    String // login | logout | export | delete | consent.grant | payment …
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// Карточка клиента, которую ведёт психолог. Не обязательно юзер платформы.
model Client {
  id             Int      @id @default(autoincrement())
  psychologist   User     @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  psychologistId Int
  name           String
  contact        String? // телефон / телеграм / email
  note           String   @default("") @db.Text // заметки психолога — шифруются
  status         String   @default("new") // new | therapy | paused
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Карточку ведёт психолог; если клиент подключил свой профиль — здесь его
  /// аккаунт. Отсюда же берётся, чьи это настроение и задания.
  user      User?     @relation("ClientUser", fields: [userId], references: [id], onDelete: SetNull)
  userId    Int?
  link      String    @default("none") // none | invited | joined
  invitedAt DateTime?

  appointments Appointment[]
  homework     Homework[]
  moods        Mood[]
  goodNotes    GoodNote[]
  therapy      TherapyProfile?

  @@index([psychologistId])
  @@index([userId])
}

/// Публичная анкета психолога — то, что видно в каталоге.
/// Основная масса полей (методы, темы, фото, ссылки, адрес) лежит в JSON:
/// это карточка, её читают и пишут целиком. Отдельными колонками вынесено
/// только то, по чему каталог фильтрует и сортирует.
model PsyProfile {
  userId         Int      @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  primaryMethod  String   @default("")
  experienceYears Int     @default(0)
  sessionPrice   Int      @default(0)
  sessionMinutes Int      @default(50)
  format         String   @default("online") // online | offline | both
  city           String   @default("")
  /// review — на модерации, approved — опубликована в каталоге
  status         String   @default("review")
  data           Json     @default("{}")
  updatedAt      DateTime @updatedAt

  @@index([status, sessionPrice])
}

/// Домашнее задание от психолога клиенту.
model Homework {
  id       Int      @id @default(autoincrement())
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId Int
  text     String   @db.Text // шифруется
  status   String   @default("assigned") // assigned | doing | done
  sentAt   DateTime @default(now())

  @@index([clientId, sentAt])
}

/// Отметка настроения за день. Одна на день — повторная правит существующую.
model Mood {
  id       Int      @id @default(autoincrement())
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId Int
  day      DateTime @db.Date
  mood     Int
  emotions Json     @default("[]")

  @@unique([clientId, day])
  @@index([clientId, day])
}

/// «Что хорошего принёс день» — короткая запись клиента. Тоже одна на день.
model GoodNote {
  id       Int      @id @default(autoincrement())
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId Int
  day      DateTime @db.Date
  text     String   @db.Text // шифруется

  @@unique([clientId, day])
}

/// Состояние терапии клиента: доска для терапевта и колесо баланса.
model TherapyProfile {
  clientId     Int      @id
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  board        String   @default("") @db.Text // шифруется
  wheel        Json? // { answers: {ключ: number[]}, completedAt }
  tutorialSeen Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

// Запись на приём.
model Appointment {
  id             Int      @id @default(autoincrement())
  psychologist   User     @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  psychologistId Int
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       Int
  startsAt       DateTime
  durationMin    Int      @default(60)
  format         String   @default("online") // online | offline
  status         String   @default("scheduled") // scheduled | done | cancelled
  note           String   @default("") @db.Text
  reminderSent   Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([psychologistId, startsAt])
  @@index([clientId])
}

// Подписка психолога (оплата через ЮKassa).
model Subscription {
  id                Int       @id @default(autoincrement())
  psychologist      User      @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  psychologistId    Int       @unique
  plan              String    @default("free") // free | pro
  status            String    @default("inactive") // inactive | pending | active
  yookassaPaymentId String?
  paymentMethodId   String? // сохранённый способ оплаты для рекуррента
  currentPeriodEnd  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
