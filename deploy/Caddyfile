# Caddy сам получает и продлевает сертификат Let's Encrypt.
# Домен подставляется из переменной окружения контейнера (см. .env).

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		# Только https в течение года — защищает от подмены на http.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Мини-приложение открывается внутри Telegram — фреймы разрешаем только ему.
		# X-Frame-Options здесь не ставим: SAMEORIGIN прямо противоречит списку
		# выше, и вебвью, которое читает его вместо CSP, покажет пустой экран.
		Content-Security-Policy "frame-ancestors https://web.telegram.org https://telegram.org"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# X-Forwarded-For заменяем целиком, а не дописываем в конец. По умолчанию
	# Caddy сохраняет присланный клиентом заголовок и лишь добавляет к нему
	# реальный адрес — приложение видело в начале списка что угодно, и любой
	# запрос со своим X-Forwarded-For обходил лимиты входа и рассылки кодов.
	handle {
		reverse_proxy app:3000 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}
