# Скопировать в /opt/bereg/.env на сервере и заполнить.
# Файл содержит секреты — chmod 600 и никогда не в git.

# Какой образ запущен. Меняется скриптом деплоя, руками трогать не нужно.
APP_IMAGE=ghcr.io/begemot-m/bereg:latest

# Домен, на котором работает приложение. Caddy получит для него сертификат.
# Прод: chronika.space — единственный адрес, других доменов у проекта нет.
APP_DOMAIN=chronika.space
APP_URL=https://chronika.space
APP_TIME_ZONE=Europe/Moscow

# Управляемый PostgreSQL у провайдера (регион РФ).
DATABASE_URL=postgresql://user:password@host:5432/bereg?sslmode=require

# Токен бота из @BotFather. Им же проверяется подпись initData.
TELEGRAM_BOT_TOKEN=

# SMTP для писем входа и подтверждения почты.
# Подойдёт SMTP хостера или Яндекс 360. Порт 465 — TLS сразу, 587 — STARTTLS.
# ВАЖНО: пусто или с опечаткой — коды входа не уходят, а печатаются открытым
# текстом в лог контейнера. На проде заполнять обязательно.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Хроника <noreply@example.ru>"

# Подпись access-токенов. Не меньше 32 символов.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Шифрование чувствительных полей: заметки, дневник настроения, колесо.
# Ровно 32 байта в base64: openssl rand -base64 32
# Потеряете ключ — расшифровать записи будет нечем. Храните копию отдельно.
DATA_KEY=

# Версия политики обработки ПД. Меняете текст — меняете дату,
# и пользователи пересогласовывают.
POLICY_VERSION=2026-07-01

# Админка. Переменной нет: владелец зашит в коде (@mmgorba) и флаг isAdmin
# проставляется ему при каждом входе — см. lib/server/access.ts.
# Помните о риске: освобождённый ник в Telegram может занять другой человек,
# и он получит админку. Меняете ник — правьте код в том же релизе.

ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=60

# Секрет крон-эндпоинта автопродления подписок: /api/cron/renew ждёт его
# в заголовке Authorization: Bearer. Пусто — эндпоинт всегда отвечает 401,
# и подписки молча не продлеваются. Сгенерировать: openssl rand -hex 32
# Дёргается по crontab раз в сутки:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#        https://chronika.space/api/cron/renew
CRON_SECRET=

# ── Бэкапы ──
# Перед каждой миграцией на диск сервера кладётся шифрованный дамп базы.
# Пароль обязателен: без него дамп не зашифровать и потом не прочитать.
# Потеряете пароль — копии станут бесполезны. Сгенерировать и сохранить
# отдельно от сервера: openssl rand -base64 32
BACKUP_PASSPHRASE=

# Где держать копии и сколько дней. Значения по умолчанию — deploy/backups и 30.
BACKUP_DIR=/opt/bereg/backups
BACKUP_KEEP_DAYS=30

# Вторая копия у ДРУГОГО провайдера — необязательна, но только она защищает от
# потери самого сервера или аккаунта. Пока пусто, за этот сценарий отвечают
# автоматические бэкапы управляемой базы Beget: восстановите их хотя бы раз
# руками и убедитесь, что они рабочие.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── ЮKassa (подключается позже) ──
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
