# Скопировать в /opt/bereg/.env на сервере и заполнить.
# Файл содержит секреты — chmod 600 и никогда не в git.

# Какой образ запущен. Меняется скриптом деплоя, руками трогать не нужно.
APP_IMAGE=ghcr.io/begemot-m/bereg:latest

# Домен, на котором работает приложение. Caddy получит для него сертификат.
# Прод: murpsy.ru   Staging: test.murpsy.ru
APP_DOMAIN=murpsy.ru
APP_URL=https://murpsy.ru

# Управляемый PostgreSQL у провайдера (регион РФ).
DATABASE_URL=postgresql://user:password@host:5432/bereg?sslmode=require

# Токен бота из @BotFather. Им же проверяется подпись initData.
TELEGRAM_BOT_TOKEN=

# Подпись access-токенов. Не меньше 32 символов.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Шифрование чувствительных полей: заметки, дневник настроения, колесо.
# Ровно 32 байта в base64: openssl rand -base64 32
# Потеряете ключ — расшифровать записи будет нечем. Храните копию отдельно.
DATA_KEY=

# Версия политики обработки ПД. Меняете текст — меняете дату,
# и пользователи пересогласовывают.
POLICY_VERSION=2026-07-01

# Куда слать алерты об ошибках. Свой chat_id узнать: написать боту,
# затем открыть https://api.telegram.org/bot<TOKEN>/getUpdates
# Пусто — ошибки только в логах контейнера.
ALERT_CHAT_ID=

# Кто получает админку при входе. Ники через запятую, без @.
# Осторожно: освобождённый ник в Telegram может занять другой человек —
# как только войдёте первый раз, надёжнее оставить список пустым, а права
# держать в базе (они при входе не снимаются).
ADMIN_USERNAMES=mmgorba

ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=60

# ── Бэкапы (S3-совместимое хранилище у ДРУГОГО провайдера) ──
BACKUP_S3_ENDPOINT=https://s3.storage.selcloud.ru
BACKUP_S3_BUCKET=bereg-backups
BACKUP_PASSPHRASE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── ЮKassa (подключается позже) ──
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
